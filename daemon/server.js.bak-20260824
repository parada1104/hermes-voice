/**
 * Hermes Voice — server local del daemon conector (multi-sesión + live)
 *
 * Expone la capa de voz + sesiones del conector como HTTP/WebSocket local,
 * para que la app Electron hable con él. Puerto por defecto 8471.
 *
 * Endpoints:
 *   POST /v1/turn      {sessionId?, agent?, audio_base64 or text, mime} → {text, audio_base64, delegation, sesionId, agente}
 *   GET  /v1/thread    ?sessionId= → {sessionId, messages}
 *   GET  /v1/sessions  → lista sesiones con estado/agentes
 *   POST /v1/sessions  {id?, agent?} → crea sesion
 *   GET  /v1/agents    → ['hermes','pi','orca']
 *   WS   /ws           → live (escuchando/transcribiendo/hablando/daemon-off, delegación.*)
 */

const http = require('http')
const { WebSocketServer } = require('ws')
const { procesarTurno, sttOmlx, ttsOmlx, listaSesiones, crearSesion, getSesion, AGENTES_DISPONIBLES, bus } = require('./connector')

const PORT = Number(process.env.HV_CONNECTOR_PORT || 8471)

function send(res, code, obj) {
  const b = typeof obj === 'string' ? obj : JSON.stringify(obj)
  res.writeHead(code, { 'Content-Type': 'application/json', 'Access-Control-Allow-Origin': '*' })
  res.end(b)
}

function readBody(req) {
  return new Promise((resolve, reject) => {
    let body = ''
    req.on('data', c => { body += c; if (body.length > 1e7) req.destroy() })
    req.on('end', () => { try { resolve(body ? JSON.parse(body) : {}) } catch (e) { reject(new Error('JSON inválido')) } })
    req.on('error', reject)
  })
}

async function handle(req, res) {
  if (req.method === 'OPTIONS') { res.writeHead(204, { 'Access-Control-Allow-Origin': '*', 'Access-Control-Allow-Methods': 'POST,GET,OPTIONS', 'Access-Control-Allow-Headers': 'Content-Type' }); res.end(); return }

  const url = new URL(req.url, `http://localhost:${PORT}`)
  const path = url.pathname
  const q = url.searchParams

  try {
    // GET /v1/thread?sessionId=
    if (req.method === 'GET' && path === '/v1/thread') {
      const sesion = getSesion(q.get('sessionId') || 'default')
      return send(res, 200, { sessionId: sesion.id, messages: sesion.thread })
    }

    // GET /v1/sessions
    if (req.method === 'GET' && path === '/v1/sessions') {
      return send(res, 200, { sessions: listaSesiones() })
    }

    // POST /v1/sessions {id?, agent?}
    if (req.method === 'POST' && path === '/v1/sessions') {
      const data = await readBody(req)
      const sesion = crearSesion(data.id || `s-${Date.now()}`, data.agent)
      return send(res, 201, { session: { id: sesion.id, agente: sesion.agente, estado: sesion.estado } })
    }

    // GET /v1/agents
    if (req.method === 'GET' && path === '/v1/agents') {
      return send(res, 200, { agents: AGENTES_DISPONIBLES })
    }

    // POST /v1/turn
    if (req.method === 'POST' && path === '/v1/turn') {
      const data = await readBody(req)
      let texto = data.text
      if (!texto && data.audio_base64) {
        const ab = Buffer.from(data.audio_base64, 'base64')
        texto = await sttOmlx(ab, data.mime)
      }
      if (!texto || !texto.trim()) return send(res, 400, { error: 'sin transcripción' })
      const turno = await procesarTurno(texto.trim(), {
        sessionId: data.sessionId || 'default',
        agent: data.agent || undefined,
      })
      let audio = null
      if (turno.text) {
        try { const wav = await ttsOmlx(turno.text); audio = wav.toString('base64') } catch (e) { /* sin audio */ }
      }
      return send(res, 200, {
        text: turno.text, audio_base64: audio,
        delegation: turno.delegation || null,
        sessionId: turno.sesionId, agent: turno.agente,
      })
    }

    return send(res, 404, { error: 'not found' })
  } catch (e) {
    return send(res, 500, { error: e.message })
  }
}

const server = http.createServer(handle)

// WebSocket live
const wss = new WebSocketServer({ server, path: '/ws' })
const clients = new Set()
wss.on('connection', ws => {
  clients.add(ws)
  ws.on('close', () => clients.delete(ws))
})
function broadcast(msg) {
  const data = JSON.stringify(msg)
  for (const ws of clients) if (ws.readyState === ws.OPEN) ws.send(data)
}

// Reenviar eventos del conector (fases + delegación) al WS
bus.on('*', ({ tipo, payload }) => broadcast({ type: tipo, payload }))
bus.on('sesion.estado', p => broadcast({ type: 'phase', payload: p }))

server.timeout = 0
server.listen(PORT, () => {
  console.log(`[hermes-voice] conector :${PORT} (REST + WS /ws)`)
})